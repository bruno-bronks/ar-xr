# Copie para .env (ignorado pelo Git). Valores FICTICIOS, somente para desenvolvimento local.
POSTGRES_USER=spatial
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=spatial

# Portas no host (sempre ligadas a 127.0.0.1). 5432 e 8000 costumam estar ocupadas nesta maquina.
API_PORT=8088
DB_PORT=55432
MQTT_PORT=1883

LOG_LEVEL=INFO

# Simulador (SPEC-007). Ciclo de 120 ticks x 2 s = 4 min: EQ-002 sobe ate CRITICAL; EQ-003 silencia (OFFLINE).
SIM_INTERVAL_SECONDS=2
SIM_CYCLE_TICKS=120
SIM_DUPLICATE_EVERY=7
SIM_LATE_EVERY=0

# Assistente de IA (SPEC-009). Padrao: extrativo, offline, sem custo. O LLM e OPCIONAL e so liga com
# ASSISTANT_PROVIDER=llm E uma chave valida (servico pago: exige sua aprovacao). Nunca versionar a chave.
ASSISTANT_PROVIDER=extractive
# ANTHROPIC_API_KEY=change-me-dev-only   # descomente SOMENTE com aprovacao; o .env real e ignorado pelo Git

# HACC Spatial (SPEC-010). Padrao: fonte SIMULADA (nenhuma conexao externa). O adaptador HTTP somente leitura
# so liga com HACC_SOURCE=http + HACC_BASE_URL + HACC_ALLOWED_HOSTS e depende do contrato REAL do HACC (nao verificado).
HACC_SOURCE=simulated
