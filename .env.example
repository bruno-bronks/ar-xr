# Copie para .env (ignorado pelo Git). Valores FICTICIOS, somente para desenvolvimento local.
POSTGRES_USER=spatial
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=spatial

# Portas no host (sempre ligadas a 127.0.0.1). 5432 e 8000 costumam estar ocupadas nesta maquina.
API_PORT=8088
DB_PORT=55432
MQTT_PORT=1883

LOG_LEVEL=INFO

# Simulador (SPEC-007). Ciclo de 120 ticks x 2 s = 4 min: EQ-002 sobe ate CRITICAL; EQ-003 silencia (OFFLINE).
SIM_INTERVAL_SECONDS=2
SIM_CYCLE_TICKS=120
SIM_DUPLICATE_EVERY=7
SIM_LATE_EVERY=0
