[Unit]
Description=Spatial AI - backup logico do PostgreSQL (pg_dump + manifesto SHA-256)
Documentation=file:///opt/ar-xr/docs/runbooks/backup-restore.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=arxr
Group=arxr
SupplementaryGroups=docker
WorkingDirectory=/opt/ar-xr
ExecStart=/usr/bin/python3 /opt/ar-xr/scripts/backup.py create --env vps --keep 14
TimeoutStartSec=30min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ar-xr/.deploy
RestrictSUIDSGID=yes
