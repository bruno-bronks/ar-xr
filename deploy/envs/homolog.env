# Ambiente de HOMOLOGACAO local (Docker): projeto Compose proprio e portas proprias, sem tocar na pilha
# de desenvolvimento nem no VPS (D-042). Sem segredos reais: valores de desenvolvimento (demo).
# Registry local de teste: docker run -d -p 127.0.0.1:5000:5000 --name spatial-registry registry:2
OPS_COMPOSE_FILES=compose.yaml,deploy/vps/compose.override.yaml
OPS_PROJECT=spatial-homolog
OPS_REGISTRY=127.0.0.1:5000/
OPS_API_URL=http://127.0.0.1:18088
OPS_SMOKE_TOKEN=demo-operator-a
OPS_WAIT_SECONDS=120
OPS_SMOKE_SECONDS=60
API_PORT=18088
DB_PORT=55433
MQTT_PORT=11883
POSTGRES_PASSWORD=homolog-dev-only
