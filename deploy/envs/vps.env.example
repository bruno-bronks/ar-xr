# MODELO para o VPS (NAO usado automaticamente; o VPS so e alterado a pedido explicito). Copie para
# deploy/envs/vps.env e ajuste. Nunca versione segredos reais (o .gitignore ignora deploy/envs/*.env
# exceto o homolog). As imagens vem de um registry (ex.: GHCR) publicado por tag `v*`.
OPS_COMPOSE_FILES=compose.yaml,deploy/vps/compose.override.yaml
OPS_PROJECT=spatial-ai
OPS_REGISTRY=ghcr.io/bruno-bronks/
OPS_API_URL=http://127.0.0.1:8088
# OPS_SMOKE_TOKEN=   (opcional; em producao nao ha token demo)
OPS_WAIT_SECONDS=180
OPS_SMOKE_SECONDS=90
# POSTGRES_PASSWORD=  <defina no servidor, nunca aqui>
